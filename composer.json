{
    "name": "ebsco/organizations-import",
    "description": "Class-based builder/importer for FOLIO organization records from delimited legacy data files.",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-zip": "*",
        "ext-simplexml": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "marnold-ebsco/phpfolioclient": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/marnold-ebsco/phpFolioClient"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Organizations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Organizations\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/build-organizations"
    ]
}
